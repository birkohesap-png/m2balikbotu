# ---- Vercel'de "Settings > Environment Variables" altina eklenecek degerler ----

# Yonetim paneli sifresi (https://m2balikbotu.com/k34)
ADMIN_SIFRE=buraya-uzun-ve-tahmin-edilemez-bir-sifre

# HMAC imza anahtari. En az 32 karakter, tamamen rastgele olsun.
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_GIZLI=buraya-64-karakterlik-rastgele-hex
LISANS_GIZLI=buraya-baska-bir-64-karakterlik-rastgele-hex

# Neon Postgres (Vercel > Storage > Create Database > Neon) baglaninca
# asagidakiler OTOMATIK gelir, elle yazmana gerek yok:
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# ---- Otomatik guncelleme (kurulum dosyasinin barindirildigi yer) ----
# Kurulum exe'si OZEL bir GitHub deposunun Releases bolumunde durur. Depo gizli
# oldugu icin dosyaya link ile ulasilamaz; site lisansi dogrulayip GitHub'dan
# kisa omurlu imzali bir adres uretir ve yalnizca gecerli lisansli bota verir.
#
# Depo adi (kullanici/depo). Kaynak kod DEGIL, sadece derlenmis kurulum dosyasi.
GH_REPO=kullanici/k34-surum
# GitHub Personal Access Token (Fine-grained). Yalnizca bu depoya
# "Contents: Read-only" yetkisi ver, baska hicbir yetki verme.
GH_TOKEN=

# ---- Telegram botu (bkz. TELEGRAM_KURULUM.md) ----
# BotFather'dan aldigin token
TELEGRAM_TOKEN=
# Webhook'u korumak icin rastgele metin:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_GIZLI=
